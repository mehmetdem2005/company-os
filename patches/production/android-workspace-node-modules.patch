-pluginManagement { includeBuild("../node_modules/@react-native/gradle-plugin") }
+pluginManagement {
+    def localPlugin = file("../node_modules/@react-native/gradle-plugin")
+    def hoistedPlugin = file("../../../node_modules/@react-native/gradle-plugin")
+    def pluginDirectory = localPlugin.exists() ? localPlugin : hoistedPlugin
+    if (!pluginDirectory.exists()) {
